# 1. Use Rust official image to build the binary
FROM rust:1.78 as builder

WORKDIR /usr/src/app

# Copy manifest and fetch dependencies
COPY Cargo.toml Cargo.lock ./
RUN cargo fetch

# Copy source code and build release binary
COPY src ./src
RUN cargo build --release

# 2. Minimal runtime image
FROM debian:bullseye-slim

# Copy binary from builder
COPY --from=builder /usr/src/app/target/release/bingo /usr/local/bin/bingo

# Expose the port your app uses
EXPOSE 8080

# Run the binary
CMD ["bingo"]
